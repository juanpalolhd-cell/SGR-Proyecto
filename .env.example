# Plantilla para producción con HTTPS. Django no carga este archivo automáticamente.
DJANGO_SECRET_KEY=generar_una_clave_privada
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.example.com

# --- HTTPS detrás de nginx (kit SGR_HTTPS_despliegue/activar_https.sh las escribe solo) ---
# Confiar en «X-Forwarded-Proto: https» que envía nginx (por defecto True si DEBUG=False).
DJANGO_SECURE_PROXY_SSL_HEADER=True
# Cookies de sesión y CSRF solo por HTTPS (por defecto True si DEBUG=False).
DJANGO_SECURE_COOKIES=True
# nginx ya redirige 80 -> 443; True agrega la misma redirección en Django.
DJANGO_SECURE_SSL_REDIRECT=False
# HSTS en segundos (0 = desactivado). El kit lo envía desde nginx (3600 al inicio).
DJANGO_SECURE_HSTS_SECONDS=0

# Base de datos (AWS/MySQL)
DB_ENGINE=mysql
DB_NAME=sgr_db
DB_USER=sgr_django
DB_PASSWORD=generar_una_clave_privada
DB_HOST=tu-rds-endpoint.amazonaws.com
DB_PORT=3306

# --- V4.2: contraseñas temporales y recuperación por correo ---
# En el servidor estos valores van en /etc/sgr/sgr.env (permisos 600). Nunca en el código ni en el chat.
SGR_CLAVE_TEMPORAL_HORAS=72
DJANGO_PASSWORD_RESET_TIMEOUT=3600
SGR_RECUPERACION_LIMITE=5
SGR_RECUPERACION_VENTANA=3600
# URL pública con la que se arma el enlace del correo. En producción debe ser HTTPS.
SGR_URL_PUBLICA=https://tu-dominio.example.com
# Detrás de nginx, para limitar por IP real (nginx debe enviar X-Forwarded-For):
SGR_PROXY_IP_HEADER=HTTP_X_FORWARDED_FOR
# Caché común a todos los procesos de gunicorn (requiere: manage.py createcachetable)
SGR_CACHE=db

# Correo saliente (SMTP). Sin estas variables, en producción no se envía nada y la
# recuperación por correo se muestra como no disponible.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.tu-proveedor.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_HOST_USER=cuenta-de-envio@tu-dominio.example.com
DJANGO_EMAIL_HOST_PASSWORD=clave_de_aplicacion_privada
DJANGO_DEFAULT_FROM_EMAIL="SGR <cuenta-de-envio@tu-dominio.example.com>"
