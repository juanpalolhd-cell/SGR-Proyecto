# Bloque para AGREGAR a /etc/sgr/sgr.env en la instancia (sudo nano /etc/sgr/sgr.env; permisos 600).
# Reemplace los valores entre <...> directamente en el servidor. No los pegue en chats ni correos.
# Use comillas dobles si un valor tiene espacios o los signos < >.

# --- Opción A: Gmail / Google Workspace (requiere verificación en 2 pasos y una "contraseña de aplicación")
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_HOST_USER=<cuenta@gmail.com>
DJANGO_EMAIL_HOST_PASSWORD=<contraseña_de_aplicacion_de_16_letras_sin_espacios>
DJANGO_DEFAULT_FROM_EMAIL="SGR <cuenta@gmail.com>"

# --- Opción B: correo institucional (Microsoft 365 / Outlook)
# DJANGO_EMAIL_HOST=smtp.office365.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# (la cuenta debe tener "SMTP AUTH" habilitado por el administrador del dominio)

# --- Opción C: Amazon SES (usuario y clave SMTP generados en la consola de SES, no las llaves de AWS Academy)
# DJANGO_EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True

# URL con la que se arma el enlace de recuperación (idealmente HTTPS con un dominio propio)
SGR_URL_PUBLICA=http://44.213.253.178
